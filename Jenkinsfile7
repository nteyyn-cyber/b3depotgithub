pipeline {
    agent any
    stages {
        stage('ChekOut-SCM') {
            steps {
                cleanWs()
                git branch: 'main', credentialsId: 'nteyyn-cyber', url: 'https://github.com/nteyyn-cyber/b3depotgithub.git'
            }
        }
        stage('Create-conteneur') {
            steps {
                sh 'docker network create -d macvlan --subnet=192.168.1.0/24 --gateway=192.168.1.1 -o parent=eth0 macvlan192 || true'
                sh 'docker stop contapache01 || true'
                sh 'docker rm contapache01 || true'
                sh 'docker run -d --name contapache01 --hostname contapache01 -v ./volumecontapache01:/var/www/html --network macvlan192 --ip 192.168.1.20 mon-apache2'
                sh 'docker start contapache01'
            }
        }
        stage('Copy-fichiers-monsite-dans-contapache01') {
            steps {
                sh '''
                    if [ -d "monsite" ]; then
                        cp -r monsite/* ./volumecontapache01
                        echo "Fichiers copiés avec succès"
                        ls ./volumecontapache01
                    else
                        echo "ERREUR : le dossier monsite est absent du repo !"
                        ls -la
                        exit 1
                    fi
                '''
            }
        }
    }
}
